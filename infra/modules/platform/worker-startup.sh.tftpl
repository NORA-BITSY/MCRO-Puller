#!/bin/bash
set -euo pipefail
umask 077
install -d -m 0700 /run/court
# COS ships Docker and its GCR credential helper. Credentials come from attached IAM.
docker-credential-gcr configure-docker --registries=${registry}
docker pull '${image}'
docker network inspect court-runtime >/dev/null 2>&1 || docker network create court-runtime
docker pull '${proxy_image}'
# Fetch one secret without jq/gcloud or embedding a payload in Terraform/metadata.
docker run --rm --network host --entrypoint node '${image}' --input-type=module -e '
const tokenResponse = await fetch("http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token", {headers:{"Metadata-Flavor":"Google"}});
if (!tokenResponse.ok) throw new Error("metadata token unavailable");
const {access_token} = await tokenResponse.json();
const response = await fetch("https://secretmanager.googleapis.com/v1/projects/${project}/secrets/${secret}/versions/latest:access", {headers:{Authorization:`Bearer $${access_token}`}});
if (!response.ok) throw new Error("database secret unavailable");
const result = await response.json();
const value = Buffer.from(result.payload.data, "base64").toString("utf8").trimEnd();
if (!value.startsWith("postgres") || /[\r\n\0]/.test(value)) throw new Error("invalid database URL secret");
console.log(`COURT_DATABASE_URL=$${value}`);
' > /run/court/worker.env
printf '%s\n' 'COURT_GCS_BUCKET=${bucket}' 'COURT_ALLOW_LIVE_MN=false' 'HOME=/tmp/court-home' >> /run/court/worker.env

cat > /etc/systemd/system/court-sql-proxy.service <<'UNIT'
[Unit]
Description=Court private Cloud SQL proxy
After=docker.service network-online.target
Requires=docker.service
[Service]
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker rm -f court-sql-proxy
ExecStart=/usr/bin/docker run --rm --name court-sql-proxy --network court-runtime --read-only --cap-drop ALL --security-opt no-new-privileges '${proxy_image}' --private-ip --address 0.0.0.0 --port 5432 '${connection}'
ExecStop=/usr/bin/docker stop --time 30 court-sql-proxy
[Install]
WantedBy=multi-user.target
UNIT
cat > /etc/systemd/system/court-worker.service <<'UNIT'
[Unit]
Description=Court acquisition and document worker
After=docker.service court-sql-proxy.service network-online.target
Requires=docker.service court-sql-proxy.service
[Service]
Restart=always
RestartSec=15
ExecStartPre=-/usr/bin/docker rm -f court-worker
ExecStart=/usr/bin/docker run --rm --name court-worker --network court-runtime --env-file /run/court/worker.env --read-only --tmpfs /tmp:rw,nosuid,size=2g,uid=1000,gid=1000 --shm-size 1g --memory 6g --cpus 2 --pids-limit 512 --cap-drop ALL --security-opt no-new-privileges '${image}' node dist/src/platform/worker.js
ExecStop=/usr/bin/docker stop --time 60 court-worker
TimeoutStopSec=75
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable court-sql-proxy court-worker
systemctl restart court-sql-proxy court-worker
