{
  "name": "MCRO-Puller",
  "version": "1.2.0",
  "description": "Durable source-grounded court record collection, reconciliation and query platform",
  "main": "cli.js",
  "bin": {
    "mcro": "./cli.js",
    "courtctl": "./dist/src/platform/courtctl.js"
  },
  "scripts": {
    "start": "node cli.js",
    "search": "node cli.js search",
    "download": "node cli.js download-case",
    "verify": "node cli.js verify",
    "status": "node cli.js status",
    "check": "pnpm typecheck && node --check cli.js && pnpm test",
    "test": "node --import tsx --test test/*.test.js test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "accept:mn": "node scripts/accept-minnesota.mjs",
    "feasibility:mn": "node scripts/feasibility-minnesota.mjs",
    "courtctl": "tsx src/platform/courtctl.ts",
    "api": "tsx src/platform/api.ts",
    "mcp": "tsx src/platform/mcp.ts",
    "worker": "tsx src/platform/worker.ts",
    "dev:database": "tsx scripts/dev-database.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@google-cloud/storage": "^9.0.0",
    "@google/genai": "^3.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "playwright": "^1.65.0",
    "playwriter": "^0.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
